PORT=4000
# Comma-separated list of allowed frontend origins (no trailing slash).
FRONTEND_URL=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/she_stands

# Administrator & optional role-based curator passwords (plaintext or bcryptjs $2b$ hash).
ADMIN_PASSWORD=change-this-before-deploying
CURATOR_PASSWORD=
OPERATIONS_PASSWORD=
JWT_SECRET=replace-with-a-long-random-secret

# Optional: enable hosted card & Google Pay checkout via Stripe and verified webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional but required for media library uploads and story attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: M-Pesa Daraja STK Push (sandbox by default).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/api/donations/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=SHE STANDS
# Optional: only set if the museum has an approved manual Paybill/Till for receipt verification.
MPESA_PAYBILL_NUMBER=
MPESA_ACCOUNT_NAME=

# Optional: PayPal Orders v2. Use sandbox credentials until merchant approval.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
