PORT=4000
FRONTEND_URL=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/she_stands
ADMIN_PASSWORD=change-this-before-deploying
JWT_SECRET=replace-with-a-long-random-secret

# Optional: enable hosted card checkout and verified Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional but required for uploads and story attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: M-Pesa Daraja STK Push (sandbox by default).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-public-domain.example/api/donations/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_ACCOUNT_REFERENCE=SHE STANDS

# Optional: PayPal Orders v2. Use sandbox credentials until merchant approval.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
