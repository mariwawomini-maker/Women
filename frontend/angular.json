{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "she-stands": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ss",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/she-stands",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": ["src/assets"],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [{"type": "initial", "maximumWarning": "2mb", "maximumError": "4mb"}],
              "outputHashing": "all",
              "optimization": {"scripts": true, "styles": {"minify": true, "inlineCritical": true}, "fonts": {"inline": false}}
            },
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {"buildTarget": "she-stands:build:production"},
            "development": {"buildTarget": "she-stands:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
